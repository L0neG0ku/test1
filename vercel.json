{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/category/:cat([a-z0-9-]+)",
      "destination": "/blog/category/:cat/",
      "permanent": true
    },
    {
      "source": "/problem",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/problem/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solution",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/solution/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why-kribble",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why-kribble/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why-parents",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/why-parents/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/developmental-story",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/developmental-story/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/#how-it-works",
      "permanent": true
    },
    {
      "source": "/how-it-works/",
      "destination": "/#how-it-works",
      "permanent": true
    },
    {
      "source": "/what-we-cover",
      "destination": "/#activities",
      "permanent": true
    },
    {
      "source": "/what-we-cover/",
      "destination": "/#activities",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/team/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/:page(explore|about|contact|survey|waitlist|privacy|terms)/",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/blog/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
